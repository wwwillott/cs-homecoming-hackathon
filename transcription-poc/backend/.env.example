GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_SPEECH_LOCATION=us
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
DATABASE_URL=postgresql+psycopg://network:network@localhost:5432/network
DEVELOPMENT_USER_ID=00000000-0000-0000-0000-000000000001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://spruce.my,https://www.spruce.my
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?|https://(www\.)?spruce\.my
MAX_UPLOAD_MB=15
# The assistant also reads openai_api from the repo root .env.
# OPENAI_API_KEY=
